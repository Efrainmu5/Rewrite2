import flixel.FlxCamera;
import flixel.FlxG;
import flixel.FlxSprite;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.tweens.FlxTween;
import flixel.util.FlxColor;
import flixel.util.FlxSave;
import flixel.util.FlxTimer;
import flixel.addons.display.FlxBackdrop;
import flixel.util.FlxAxes;
import funkin.Paths;
import funkin.PlayerSettings;
import funkin.audio.FunkinSound;
import funkin.ui.MusicBeatState;
import funkin.ui.ScriptedMusicBeatState;
import haxe.Exception;
import openfl.display.BlendMode;
import funkin.ui.options.OptionsState;
import funkin.ui.debug.DebugMenuSubState;
import flixel.FlxSubState;
import funkin.data.song.SongRegistry;
import funkin.ui.transition.LoadingState;
import funkin.play.PlayStatePlaylist;

class RewriteMainMenuState extends MusicBeatState
{
    public function new()
    {
        super();
    }

    var DW:Float = 820.0;//resolucion XD
    var DH:Float = 720.0;
    var offsetX:Float = 0.0;
    var offsetY:Float = 0.0;

    var px:Float = -9999.0;
    var py:Float = -9999.0;
    var tap:Bool = false;
    var tapHeld:Bool = false;
    var onDebugMenu:Bool = false;

    static var PREFS_CLS:Dynamic = null; //preferencias o confi
    static var PREFS_CHECKED:Bool = false;

    function getPrefsClass()
    {
        if (!PREFS_CHECKED)
        {
            PREFS_CLS = Type.resolveClass("funkin.Preferences");
            PREFS_CHECKED = true;
        }
        return PREFS_CLS;
    }

    function initLayout()
    {
        offsetX = (FlxG.width - DW) / 2;
        offsetY = (FlxG.height - DH) / 2;
        FlxG.camera.bgColor = 0xFF000000;
    }

    function put(o:Dynamic)
    {
        add(o);
        return o;
    }

    function ctr(s:FlxSprite, axis:Int)
    {
        if (axis != 0x10) s.x = offsetX + (DW - s.width) / 2;
        if (axis != 0x01) s.y = offsetY + (DH - s.height) / 2;
    }

    function mkText(x:Float, y:Float, w:Float, str:String, size:Int, color:Int, align:String, font:String)
    {
        final t:FlxText = new FlxText(offsetX + x, offsetY + y, w, str);
        t.setFormat(Paths.font(font), size, color, align, FlxTextBorderStyle.SHADOW, 0xFF000000);
        t.shadowOffset.x += 1;
        t.shadowOffset.y += 3;
        return t;
    }

    function mkBlueFade()
    {
        final f:FlxSprite = new FlxSprite(offsetX, offsetY).makeGraphic(Std.int(DW), Std.int(DH), 0xFF0000FF);
        f.blend = BlendMode.MULTIPLY;
        f.alpha = 0.001;
        put(f);
        return f;
    }

    function ctl()
    {
        return PlayerSettings.player1.controls;
    }

    function isMobile():Bool
    {
        try
        {
            return FlxG.onMobile == true;
        }
        catch (e:Exception) {}
        return false;
    }

    function readPointer()
    {
        tap = false;
        tapHeld = false;

        px = FlxG.mouse.screenX;
        py = FlxG.mouse.screenY;
        tap = FlxG.mouse.justPressed;
        tapHeld = FlxG.mouse.pressed;
    }

    function over(s:FlxSprite)
    {
        return s != null && px >= s.x && px <= s.x + s.width && py >= s.y && py <= s.y + s.height;
    }

    function go(name:String)
    {
        if (name == null || name == "RewriteOptionsState") {

            FlxG.switchState(new OptionsState());
            return;
        }
        final s = ScriptedMusicBeatState.init(name);
        if (s == null) return false;
        FlxG.switchState(s);
        return true;
    }

    function prefsObj() //saves
    {
        final s:FlxSave = new FlxSave();
        s.bind("rewrite_mod", "rewrite");
        return s;
    }

    function pget(key:String, def:Dynamic)
    {
        var v:Dynamic = prefsObj().data[key];
        return v == null ? def : v;
    }

    function pset(key:String, val:Dynamic)
    {
        final s = prefsObj();
        s.data[key] = val;
        s.flush();
    }

    function sget(key:String, def:Dynamic)
    {
        final s = new FlxSave();
        s.bind("rewrite_session", "rewrite");
        var v:Dynamic = s.data[key];
        return v == null ? def : v;
    }

    function sset(key:String, val:Dynamic)
    {
        final s = new FlxSave();
        s.bind("rewrite_session", "rewrite");
        s.data[key] = val;
    }

    function playMenuMusic(name:String, vol:Float, loop:Bool)
    {
        try
        {
            FunkinSound.playMusic(name, {
                volume: vol,
                loop: loop,
                persist: true,
                restart: false
            });
        }
        catch (e:Exception)
        {
            try { FlxG.sound.playMusic(Paths.music(name), vol, loop); }
            catch (e2:Exception) {}
        }
    }

    function stopMusic()
    {
        if (FlxG.sound.music != null) FlxG.sound.music.stop();
    }

    function overS(s:FlxSprite)
    {
        if (s == null) return false;
        final w:Float = s.frameWidth * Math.abs(s.scale.x);
        final h:Float = s.frameHeight * Math.abs(s.scale.y);
        final cx:Float = s.x + s.width / 2;
        final cy:Float = s.y + s.height / 2;
        return px >= cx - w / 2 && px <= cx + w / 2 && py >= cy - h / 2 && py <= cy + h / 2;
    }

    var backBtn:FlxSprite = null;

    function makeBackBtn()
    {
        if (!isMobile()) return;
        backBtn = new FlxSprite(10, 635).loadGraphic(Paths.image("menus/options/back"));
        backBtn.scale.set(3, 3);
        backBtn.updateHitbox();
        put(backBtn);
    }

    function backPressed()
    {
        return ctl().BACK || (tap && backBtn != null && backBtn.visible && over(backBtn));
    }

    var DIFFICULTY:String = "normal";
    var debug:Bool = false;
    var UNLOCK_GALLERY_FOR_TESTING:Bool = true;//quitarlo

    var bg:FlxSprite = null;
    var clouds:FlxBackdrop = null;
    var special:FlxBackdrop = null;
    var curTransform:Bool = true;
    var menuTitle:FlxSprite = null;

    var menuItems:Array<Dynamic> = [["TRACKS", true, null], ["SETTINGS", true, null], ["GALLERY", false, null], ["CREDITS", false, null]];
    var sonicText:FlxText = null;
    var selector:FlxSprite = null;
    var curSelected:Int = 0;
    var curSelectedRemix:Int = 0;
    var curSelectedFile:Int = 0;
    var selectedSomething:Bool = false;

    var bf:FlxSprite = null;
    var dataSelector:FlxSprite = null;
    var arrows:FlxSprite = null;
    var blueFade:FlxSprite = null;

    var menuMode:Bool = false;
    var leaving:Bool = false;

    var songs:Array<Dynamic> = [["Thriller", true, true], ["Trinity", false, true]];
    var remixes:Array<Dynamic> = [];
    var files:Array<Dynamic> = [[], []];
    var page:Int = 0;

    override function create()
    {
        super.create();
        initLayout();
        onDebugMenu = false;
        FlxG.mouse.visible = false;

        remixes = [["", true], [pget("remixedLegacySongs", false) == true ? " Remixed" : " Legacy", false]];

        FlxG.camera.alpha = 0;
        new FlxTimer().start(0.001, function(t0:FlxTimer) {
            FlxG.camera.alpha = 1;
            FlxG.camera.flash(0xFF000000, 0.6);
        });

        final beatenTG:Bool = pget("beatenTG", false) == true;
        final beatenTrinity:Bool = pget("beatenTrinity", false) == true;

        if (beatenTG || debug)
        {
            for (i in songs) if (i[0] == "Trinity") i[1] = true;
        }

        if (beatenTrinity || debug)
        {
            menuItems[2][1] = true;
            menuItems[3][1] = true;
            for (i in remixes) i[1] = true;
        }

        if (UNLOCK_GALLERY_FOR_TESTING)
        {
            menuItems[2][1] = true;
            menuItems[3][1] = true;
        }

        playMenuMusic("freakyMenu", 1.0, true);
        if (FlxG.sound.music != null) FlxG.sound.music.volume = 1;

        bg = new FlxSprite().loadGraphic(Paths.image("menus/main/bg"));
        bg.setGraphicSize(Std.int(DW), Std.int(DH));
        bg.updateHitbox();
        put(bg);

        clouds = new FlxBackdrop(Paths.image("menus/main/clouds"), FlxAxes.X);
        clouds.velocity.x = 10;
        put(clouds);

        special = new FlxBackdrop(Paths.image("menus/main/clouds"), FlxAxes.X);
        special.frames = Paths.getSparrowAtlas("menus/main/special");
        special.animation.addByPrefix("swap", "special", 8, false);
        special.velocity.x = FlxG.random.float(-8, -19);
        put(special);

        special.animation.finishCallback = function(fin:String) {
            clouds.velocity.x = curTransform ? 10 : -10;
            special.velocity.x = curTransform ? FlxG.random.float(-8, -19) : FlxG.random.float(8, 19);
        };

        new FlxTimer().start(10, function(t1:FlxTimer) {
            special.velocity.x = 0;
            curTransform = !curTransform;
            special.animation.play("swap", true, curTransform);
        }, 0);

        menuTitle = new FlxSprite();
        menuTitle.frames = Paths.getSparrowAtlas("menus/main/menuTitles");
        menuTitle.animation.addByPrefix("mainMenu", "mainMenu", 1, true);
        menuTitle.animation.addByPrefix("dataSelect", "dataSelect", 1, true);
        menuTitle.animation.play("mainMenu");
        put(menuTitle);

        for (i in [bg, clouds, special, menuTitle])
        {
            if (i != bg)
            {
                final sc:Float = (i == menuTitle) ? 2.75 : 4;
                i.scale.set(sc, sc);
            }
            ctr(i, 0x11);
        }

        menuTitle.y -= 290;

        for (i in 0...menuItems.length) //opciones IMPORTANTEE
        {
            final menuText:FlxText = mkText(0, 0, DW, menuItems[i][0], 55, menuItems[i][1] ? 0xFFFFFFFF : 0xFFB4B4B4, "center", "sonic2HUD.ttf");
            ctr(menuText, 0x11);
            menuText.y += i * 70 - 80;
            menuItems[i][2] = menuText;
            put(menuText);
        }

        sonicText = mkText(0, 550, DW, "PLAY SONIC'S GAME TO ACCESS THIS OPTION", 45, 0xFFFF0000, "center", "sonic2HUD.ttf");
        ctr(sonicText, 0x01);
        sonicText.visible = false;
        put(sonicText);

        selector = new FlxSprite().loadGraphic(Paths.image("menus/main/selector"));
        selector.scale.set(4, 4);
        ctr(selector, 0x01);
        put(selector);

        changeSelection(0, true);

        // CANCIONESS
        for (i in 0...2)
        {
            final file:FlxSprite = new FlxSprite().loadGraphic(Paths.image("menus/main/file"));
            file.scale.set(3.5, 3.5);
            file.alpha = 0.001;
            ctr(file, 0x10);
            file.x = offsetX + 160 + i * 407;
            file.y += 50;
            files[i].push(file);
            put(file);

            final icon:FlxSprite = new FlxSprite().loadGraphic(Paths.image("menus/main/icons/Thriller Gen"));
            icon.scale.set(3.51, 3.51);
            icon.alpha = 0.001;
            icon.x = file.x - 2;
            icon.y = file.y - 112;
            files[i].push(icon);
            put(icon);

            final title:FlxSprite = new FlxSprite().loadGraphic(Paths.image("menus/main/titles/Thriller Gen"));
            title.scale.set(3.5, 3.5);
            title.alpha = 0.001;
            title.x = file.x + 10;
            title.y = file.y + 100;
            files[i].push(title);
            put(title);

            final lock:FlxSprite = new FlxSprite().loadGraphic(Paths.image("menus/main/x"));
            lock.scale.set(3.5, 3.5);
            lock.alpha = 0.001;
            lock.visible = false;
            lock.x = file.x + 25;
            lock.y = file.y + 240;
            files[i].push(lock);
            put(lock);

            final staticSprite:FlxSprite = new FlxSprite();
            staticSprite.frames = Paths.getSparrowAtlas("menus/main/static");
            staticSprite.animation.addByPrefix("static", "static", 12, true);
            staticSprite.animation.play("static");
            staticSprite.scale.set(3.51, 3.51);
            staticSprite.alpha = 0.001;
            staticSprite.x = icon.x;
            staticSprite.y = icon.y;
            staticSprite.visible = false;
            files[i].push(staticSprite);
            put(staticSprite);

            files[i].push([]);
        }

        bf = new FlxSprite(offsetX + 0, offsetY + 560).loadGraphic(Paths.image("menus/main/boyfriend"));
        bf.scale.set(4, 4);
        bf.alpha = 0.001;
        put(bf);

        dataSelector = new FlxSprite(offsetX + 0, offsetY + 320).loadGraphic(Paths.image("menus/main/select"));
        dataSelector.scale.set(3.5, 3.5);
        dataSelector.alpha = 0.001;
        put(dataSelector);

        arrows = new FlxSprite(offsetX + 250, offsetY + 205).loadGraphic(Paths.image("menus/main/arrows"));
        arrows.scale.set(3.5, 3.5);
        arrows.alpha = 0.001;
        if (beatenTrinity || debug) put(arrows);

        blueFade = mkBlueFade();

        makeBackBtn(); //como el esc pero pa celular

        final leftBar:FlxSprite = new FlxSprite(0, 0).makeGraphic(Std.int(offsetX), Std.int(FlxG.height), 0xFF000000);
        put(leftBar);

        final rightBar:FlxSprite = new FlxSprite(Std.int(FlxG.width - offsetX), 0).makeGraphic(Std.int(offsetX), Std.int(FlxG.height), 0xFF000000);
        put(rightBar);

        new FlxTimer().start(0.5, function(t2:FlxTimer) {
            arrows.visible = !arrows.visible;
        }, 0);

        if (sget("dataSelect", false) == true) changeMenus(true);
    }

    function reloadSongs()
    {
        for (i in 0...files.length)
        {
            final num:Int = i + page;
            files[i][1].loadGraphic(Paths.image("menus/main/icons/" + songs[num][0] + remixes[curSelectedRemix][0]));
            files[i][2].loadGraphic(Paths.image("menus/main/titles/" + songs[num][0] + remixes[curSelectedRemix][0]));
            files[i][5] = songs[num];
        }
    }

    function changeSelection(change:Int, silent:Bool) //cambiar de opcion
    {
        if (!silent) FlxG.sound.play(Paths.sound("scrollMenu"), 0.8);

        if (!menuMode)
        {
            curSelected += change;
            if (curSelected > menuItems.length - 1) curSelected = 0;
            if (curSelected < 0) curSelected = menuItems.length - 1;

            for (i in 0...menuItems.length)
            {
                if (i == curSelected) menuItems[i][2].color = menuItems[i][1] ? 0xFFFCFC00 : 0xFFB5B500;
                else menuItems[i][2].color = menuItems[i][1] ? 0xFFFFFFFF : 0xFFB4B4B4;
            }

            selector.y = menuItems[curSelected][2].y + 25;
            selector.color = menuItems[curSelected][2].color;
        }
        else
        {
            curSelected += change;
            if (curSelected > songs.length - 1) curSelected = 0;
            if (curSelected < 0) curSelected = songs.length - 1;

            curSelectedFile += change;
            if (curSelectedFile > files.length - 1) curSelectedFile = 0;
            if (curSelectedFile < 0) curSelectedFile = files.length - 1;

            curSelectedRemix = 0;

            if (curSelected % 2 == 0) page = curSelected;
            if (change == -1 && curSelected == 1) page = 0;
            if (change == -1 && curSelected == 3) page = 2;

            reloadSongs();

            dataSelector.x = files[curSelectedFile][0].x - 10;
            bf.x = files[curSelectedFile][0].x + 20;
            bf.alpha = files[curSelectedFile][5][1] ? 1 : 0.001;
            arrows.x = files[curSelectedFile][0].x + 30;

            for (i in 0...files.length)
            {
                FlxTween.cancelTweensOf(files[i][4]);
                files[i][4].alpha = 1;
                if (files[i][5][1]) files[i][4].visible = (i != curSelectedFile);
                else files[i][4].visible = true;

                if (i == curSelectedFile)
                {
                    if (files[i][5][2]) arrows.alpha = files[i][5][1] ? 1 : 0.001;
                    else arrows.alpha = 0.001;
                }
                files[i][3].visible = files[i][5][1] ? false : true;
            }
        }
    }

    function changeMix(change:Int, silent:Bool)
    {
        final beatenTrinity:Bool = pget("beatenTrinity", false) == true;
        if (!menuMode || !files[curSelectedFile][5][1] || !files[curSelectedFile][5][2] || (!beatenTrinity && !debug)) return;

        if (!silent) FlxG.sound.play(Paths.sound("scrollMenu"), 0.8);

        curSelectedRemix += change;
        if (curSelectedRemix > remixes.length - 1) curSelectedRemix = 0;
        if (curSelectedRemix < 0) curSelectedRemix = remixes.length - 1;

        if (remixes[curSelectedRemix][1] == false)
        {
            changeMix(change + 1, true);
            return;
        }

        files[curSelectedFile][1].loadGraphic(Paths.image("menus/main/icons/" + files[curSelectedFile][5][0] + remixes[curSelectedRemix][0]));
        files[curSelectedFile][2].loadGraphic(Paths.image("menus/main/titles/" + files[curSelectedFile][5][0] + remixes[curSelectedRemix][0]));

        FlxTween.cancelTweensOf(files[curSelectedFile][4]);
        files[curSelectedFile][4].visible = true;
        files[curSelectedFile][4].alpha = 1;
        FlxTween.tween(files[curSelectedFile][4], {alpha: 0.001}, 0.5, {
            onComplete: function(twn:FlxTween) {
                files[curSelectedFile][4].visible = false;
                files[curSelectedFile][4].alpha = 1;
            }
        });
    }

    function changeMenus(which:Bool):Void
    {
        sset("dataSelect", which);

        menuMode = which;
        curSelected = 0;
        curSelectedFile = 0;
        curSelectedRemix = 0;
        changeSelection(0, true);
        selectedSomething = false;
        menuTitle.animation.play(which ? "dataSelect" : "mainMenu");
        menuTitle.offset.x = which ? 20 : 0;

        if (menuMode)
        {
            for (i in menuItems) i[2].alpha = 0.001;
            for (i in [selector, sonicText]) i.alpha = 0.001;
            for (i in files) for (o in i) if (o != i[5]) o.alpha = 1;
            for (i in [bf, dataSelector, arrows]) i.alpha = 1;
        }
        else
        {
            for (i in menuItems) i[2].alpha = 1;
            for (i in [selector, sonicText]) i.alpha = 1;
            for (i in files) for (o in i)
            {
                if (o == i[4]) FlxTween.cancelTweensOf(o);
                if (o != i[5]) o.alpha = 0.001;
            }
            for (i in [bf, dataSelector, arrows]) i.alpha = 0.001;
        }
    }

    function leaveTo(name:String, stop:Bool)
    {
        FlxTween.tween(blueFade, {alpha: 1}, 0.5);
        FlxG.camera.fade(0xFF000000, 0.7);
        new FlxTimer().start(0.75, function(t3:FlxTimer) {
            if (stop) stopMusic();
            go(name);
        });
    }

    function songId(name:String) //fuck
    {
        return name.toLowerCase().split(" ").join("-");
    }

function startSong()
    {
        final mix:String = remixes[curSelectedRemix][0];
        var id:String = songId(files[curSelectedFile][5][0]);
        var variation:String = "default";

        if (mix == " Legacy") id += "-legacy";
        if (mix == " Remixed")
        {
            id += "-legacy";
            variation = "remixed";
        }

        trace("[DEBUG] Intentando cargar canción -> ID final: " + id + " | Variation: " + variation);

        // Llamada directa y nativa sin usar Type.resolveClass
        var entry = SongRegistry.instance.fetchEntry(id);

        if (entry == null)
        {
            trace("[DEBUG ERROR] La entrada de la canción es nula. No se encontró en SongRegistry.");
            FlxG.sound.play(Paths.sound("denied"));
            selectedSomething = false;
            return;
        }

        stopMusic();
        FlxG.mouse.visible = false;

        PlayStatePlaylist.isStoryMode = false;

        FlxTimer.globalManager.forEach(function(tm:FlxTimer) tm.active = false);
        FlxTween.globalManager.forEach(function(tw:FlxTween) tw.active = false);

        LoadingState.loadPlayState({
            targetSong: entry,
            targetDifficulty: DIFFICULTY,
            targetVariation: variation,
            practiceMode: false,
            minimalMode: false,
            botPlayMode: false,
            isStoryMode: false
        }, true);
    }

    function selectSomething()
    {
        if (!menuMode)
        {
            selectedSomething = true;
            if (menuItems[curSelected][1])
            {
                FlxG.sound.play(Paths.sound("confirmMenu"));
                var selected:Bool = true;
                new FlxTimer().start(0.05, function(t4:FlxTimer) {
                    selected = !selected;
                    menuItems[curSelected][2].color = selected ? 0xFFFFFFFF : 0xFFFCFC00;
                    selector.color = menuItems[curSelected][2].color;
                }, 21);

                new FlxTimer().start(1.4, function(t5:FlxTimer) {
                    switch (curSelected)
                    {
                        case 0: changeMenus(true);
                        case 1: leaveTo("RewriteOptionsState", false);
                        case 2: leaveTo("RewriteGalleryState", true);
                        case 3: leaveTo("RewriteCreditsState", false);
                        default:
                    }
                });
            }
            else
            {
                new FlxTimer().start(0.05, function(t6:FlxTimer) {
                    sonicText.visible = !sonicText.visible;
                }, 16);

                FlxG.sound.play(Paths.sound("denied"));

                new FlxTimer().start(0.8, function(t7:FlxTimer) {
                    selectedSomething = false;
                });
            }
        }
        else
        {
            // Validamos directamente desde la estructura del archivo seleccionado en pantalla (índice [5][1] que almacena el estado booleano de unlocked)
            if (files[curSelectedFile].length > 5 && files[curSelectedFile][5] != null && files[curSelectedFile][5][1] == true)
            {
                selectedSomething = true;
                // Intentamos reproducir el sonido de selección si existe, si no, usa confirmMenu por seguridad
                try { FlxG.sound.play(Paths.sound("selectSong")); } catch (e:Exception) { FlxG.sound.play(Paths.sound("confirmMenu")); }
                
                FlxG.camera.fade(0xFF000000, 1.25);

                new FlxTimer().start(0.05, function(t9:FlxTimer) {
                    if (dataSelector != null) dataSelector.visible = !dataSelector.visible;
                }, 21);

                FlxTween.tween(blueFade, {alpha: 1}, 1.1);
                if (FlxG.sound.music != null) FlxTween.tween(FlxG.sound.music, {volume: 0}, 0.9);

                new FlxTimer().start(1.25, function(t10:FlxTimer) {
                    startSong(); // <--- Carga automáticamente el remix y la canción correcta
                });
            }
            else
            {
                selectedSomething = true;
                FlxG.sound.play(Paths.sound("denied"));
                new FlxTimer().start(0.8, function(t8:FlxTimer) {
                    selectedSomething = false;
                });
            }
        }
    }

    override function update(elapsed:Float)
    {
        super.update(elapsed);
        readPointer();

        if (debug && !selectedSomething && FlxG.keys.justPressed.SEVEN) //inputsss
        {
            FlxG.camera.alpha = 0;
            go("RewriteMasterEditorState");
            return;
        }

        if (!selectedSomething && FlxG.keys.justPressed.F2) //inputsss
        {
            FlxG.camera.alpha = 0.99;
            FlxG.state.openSubState(new DebugMenuSubState());
            onDebugMenu = true;
            return;
        }

        if (selectedSomething) return;

        if (ctl().UI_UP_P)
        {
            if (!menuMode) changeSelection(-1, false);
            else changeMix(-1, false);
        }
        if (ctl().UI_DOWN_P)
        {
            if (!menuMode) changeSelection(1, false);
            else changeMix(1, false);
        }
        if (ctl().UI_LEFT_P && menuMode) changeSelection(-1, false);
        if (ctl().UI_RIGHT_P && menuMode) changeSelection(1, false);
        if (ctl().ACCEPT)
        {
            selectSomething();
            return;
        }

        if (tap)
        {
            if (!menuMode)
            {
                for (i in 0...menuItems.length)
                {
                    if (over(menuItems[i][2]))
                    {
                        if (curSelected == i) selectSomething();
                        else changeSelection(i - curSelected, false);
                        return;
                    }
                }
            }
            else
            {
                if (arrows.alpha == 1 && arrows.visible && overS(arrows))
                {
                    changeMix(1, false);
                    return;
                }
                for (i in 0...files.length)
                {
                    if (overS(files[i][0]))
                    {
                        if (curSelectedFile == i) selectSomething();
                        else changeSelection(i - curSelectedFile, false);
                        return;
                    }
                }
            }
        }

        if (backPressed() && !leaving && !onDebugMenu)
        {
            if (menuMode && onDebugMenu)
            {
                changeMenus(false);
                FlxG.sound.play(Paths.sound("cancelMenu"));
            }
            else
            {
                leaving = true;
                FlxG.camera.fade(0xFF000000, 0.9);
                if (FlxG.sound.music != null) FlxTween.tween(FlxG.sound.music, {volume: 0}, 0.9);
                FlxTween.tween(blueFade, {alpha: 1}, 0.6);
                new FlxTimer().start(0.95, function(t11:FlxTimer) {
                    stopMusic();
                    sset("flashSeen", true);
                    go("RewriteTitleState");
                });
            }
        }
        if (backPressed() && !leaving && onDebugMenu)
        {
                final menu = ScriptedMusicBeatState.init("RewriteMainMenuState");
                FlxG.switchState(menu);
                onDebugMenu = false;
                return;
        }
    }
}