import flixel.FlxG;
import flixel.FlxSprite;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.tweens.FlxTween;
import flixel.util.FlxColor;
import flixel.util.FlxSave;
import flixel.util.FlxTimer;
import funkin.Paths;
import funkin.PlayerSettings;
import funkin.audio.FunkinSound;
import funkin.ui.MusicBeatState;
import funkin.ui.ScriptedMusicBeatState;
import haxe.Exception;
import openfl.display.BlendMode;

class RewriteGalleryState extends MusicBeatState
{
    public function new()
    {
        super();
    }

    // ======================================================================
    //  BLOQUE COMUN (mismo estilo que RewriteMainMenuState)
    // ======================================================================
    var DW:Float = 820.0;
    var DH:Float = 720.0;
    var offsetX:Float = 0.0;
    var offsetY:Float = 0.0;

    var px:Float = -9999.0;
    var py:Float = -9999.0;
    var tap:Bool = false;
    var tapHeld:Bool = false;

    function initLayout():Void
    {
        offsetX = (FlxG.width - DW) / 2;
        offsetY = (FlxG.height - DH) / 2;
        FlxG.camera.bgColor = 0xFF000000;
    }

    function put(o:Dynamic):Dynamic
    {
        add(o);
        return o;
    }

    // equivalente a screenCenter() dentro del canvas de 820x720
    function ctr(s:FlxSprite, axis:Int):Void
    {
        if (axis != 0x10) s.x = offsetX + (DW - s.width) / 2;
        if (axis != 0x01) s.y = offsetY + (DH - s.height) / 2;
    }

    function mkText(x:Float, y:Float, w:Float, str:String, size:Int, color:Int, align:String, font:String):FlxText
    {
        final t:FlxText = new FlxText(offsetX + x, offsetY + y, w, str);
        t.setFormat(Paths.font(font), size, color, align, FlxTextBorderStyle.SHADOW, 0xFF000000);
        t.shadowOffset.x += 1;
        t.shadowOffset.y += 3;
        return t;
    }

    function mkBlueFade():FlxSprite
    {
        final f:FlxSprite = new FlxSprite(offsetX, offsetY).makeGraphic(Std.int(DW), Std.int(DH), 0xFF0000FF);
        f.blend = BlendMode.MULTIPLY;
        f.alpha = 0.001;
        put(f);
        return f;
    }

    function ctl():Dynamic
    {
        return PlayerSettings.player1.controls;
    }

    function isMobile():Bool
    {
        try
        {
            return FlxG.onMobile == true;
        }
        catch (e:Exception) {}
        return false;
    }

    // raton (PC) + pantalla tactil (movil) en un solo puntero.
    // Las coordenadas son del mundo de la camara, asi que cuadran con x/y de los sprites.
    function readPointer():Void
    {
        tap = false;
        tapHeld = false;

        try
        {
            final p = FlxG.mouse.getWorldPosition(FlxG.camera);
            px = p.x;
            py = p.y;
            p.put();
        }
        catch (e:Exception)
        {
            px = FlxG.mouse.screenX;
            py = FlxG.mouse.screenY;
        }
        tap = FlxG.mouse.justPressed;
        tapHeld = FlxG.mouse.pressed;

        try
        {
            for (t in FlxG.touches.list)
            {
                final tp = t.getWorldPosition(FlxG.camera);
                if (t.justPressed)
                {
                    px = tp.x;
                    py = tp.y;
                    tap = true;
                }
                if (t.pressed) tapHeld = true;
                tp.put();
            }
        }
        catch (e2:Exception) {}
    }

    // trim propio (StringTools no esta disponible dentro de los scripts)
    function trimStr(s:String):String
    {
        var a:Int = 0;
        var b:Int = s.length;
        while (a < b && (s.charAt(a) == " " || s.charAt(a) == "\r" || s.charAt(a) == "\n" || s.charAt(a) == "\t")) a++;
        while (b > a && (s.charAt(b - 1) == " " || s.charAt(b - 1) == "\r" || s.charAt(b - 1) == "\n" || s.charAt(b - 1) == "\t")) b--;
        return s.substr(a, b - a);
    }

    function over(s:FlxSprite):Bool
    {
        return s != null && px >= s.x && px <= s.x + s.width && py >= s.y && py <= s.y + s.height;
    }

    function go(name:String):Bool
    {
        final s = ScriptedMusicBeatState.init(name);
        if (s == null)
        {
            trace("[Rewrite] No se pudo cargar: " + name);
            return false;
        }
        FlxG.switchState(s);
        return true;
    }

    // ---- guardados ----
    function prefsObj():FlxSave
    {
        final s:FlxSave = new FlxSave();
        s.bind("rewrite_mod", "rewrite");
        return s;
    }

    function pget(key:String, def:Dynamic):Dynamic
    {
        var v:Dynamic = prefsObj().data[key];
        return v == null ? def : v;
    }

    function pset(key:String, val:Dynamic):Void
    {
        final s = prefsObj();
        s.data[key] = val;
        s.flush();
    }

    function sget(key:String, def:Dynamic):Dynamic
    {
        final s = new FlxSave();
        s.bind("rewrite_session", "rewrite");
        var v:Dynamic = s.data[key];
        return v == null ? def : v;
    }

    function sset(key:String, val:Dynamic):Void
    {
        final s = new FlxSave();
        s.bind("rewrite_session", "rewrite");
        s.data[key] = val;
    }

    function flashingOn():Bool
    {
        final v:Dynamic = pget("flashing", null);
        if (v != null) return v == true;
        try
        {
            final cls = Type.resolveClass("funkin.Preferences");
            if (cls != null)
            {
                final n:Dynamic = Reflect.getProperty(cls, "flashingLights");
                if (n != null) return n == true;
            }
        }
        catch (e:Exception) {}
        return true;
    }

    // reproduce una musica (nombre de V-Slice) y si no suena, prueba la ruta plana
    function playMenuMusic(name:String, vol:Float, loop:Bool):Void
    {
        try
        {
            FunkinSound.playMusic(name, {
                startingVolume: vol,
                overrideExisting: true,
                restartTrack: true,
                loop: loop,
                volume: vol,
                persist: true,
                restart: true
            });
        }
        catch (e:Exception) {}

        if (FlxG.sound.music == null || !FlxG.sound.music.playing)
        {
            try { FlxG.sound.playMusic(Paths.music(name), vol, loop); }
            catch (e2:Exception) {}
        }
    }

    function stopMusic():Void
    {
        if (FlxG.sound.music != null) FlxG.sound.music.stop();
    }

    function fadeMusicTo(vol:Float, time:Float):Void
    {
        if (FlxG.sound.music != null) FlxTween.tween(FlxG.sound.music, {volume: vol}, time);
    }

    function overS(s:FlxSprite):Bool
    {
        if (s == null) return false;
        final w:Float = s.frameWidth * Math.abs(s.scale.x);
        final h:Float = s.frameHeight * Math.abs(s.scale.y);
        final cx:Float = s.x + s.width / 2;
        final cy:Float = s.y + s.height / 2;
        return px >= cx - w / 2 && px <= cx + w / 2 && py >= cy - h / 2 && py <= cy + h / 2;
    }

    // barras negras para tapar lo que sobresale del canvas 820x720 (se llama al final)
    function addBars():Void
    {
        if (offsetX > 0)
        {
            put(new FlxSprite(0, 0).makeGraphic(Std.int(offsetX), Std.int(FlxG.height), 0xFF000000));
            put(new FlxSprite(FlxG.width - offsetX, 0).makeGraphic(Std.int(offsetX) + 1, Std.int(FlxG.height), 0xFF000000));
        }
        if (offsetY > 0)
        {
            put(new FlxSprite(0, 0).makeGraphic(Std.int(FlxG.width), Std.int(offsetY), 0xFF000000));
            put(new FlxSprite(0, FlxG.height - offsetY).makeGraphic(Std.int(FlxG.width), Std.int(offsetY) + 1, 0xFF000000));
        }
    }

    // cursor propio del mod (solo en PC)
    var customCursor:FlxSprite = null;

    function makeCursor():Void
    {
        try
        {
            customCursor = new FlxSprite(-100, -100);
            customCursor.frames = Paths.getSparrowAtlas("cursor");
            customCursor.animation.addByPrefix("default", "default", 24, false);
            customCursor.animation.addByPrefix("wait", "wait", 24, false);
            customCursor.animation.addByPrefix("hover", "hover", 24, false);
            customCursor.animation.play("default");
            customCursor.scale.set(1.5, 1.5);
            customCursor.visible = !isMobile();
            put(customCursor);
        }
        catch (e:Exception)
        {
            // sin cursor propio: se usa el del sistema
            trace("[Rewrite] No se pudo crear el cursor: " + e);
            customCursor = null;
            FlxG.mouse.visible = true;
        }
    }

    var cursorForceX:Float = -1.0;
    var cursorForceY:Float = -1.0;

    function cursorAnim(name:String):Void
    {
        if (customCursor == null) return;
        if (cursorForceX >= 0)
        {
            customCursor.x = cursorForceX;
            customCursor.y = cursorForceY;
        }
        else
        {
            customCursor.x = FlxG.mouse.x;
            customCursor.y = FlxG.mouse.y;
        }
        try
        {
            if (customCursor.animation.curAnim == null || customCursor.animation.curAnim.name != name) customCursor.animation.play(name, true);
        }
        catch (e:Exception) {}
    }

    // ---- depuracion: F9 muestra la posicion del puntero y las zonas clickeables ----
    var dbgOn:Bool = false;
    var dbgText:FlxText = null;
    var dbgTargets:Array<FlxSprite> = [];
    var dbgBoxes:Array<FlxSprite> = [];

    function dbgSet(list:Array<FlxSprite>):Void
    {
        dbgTargets = list;
    }

    function dbgUpdate():Void
    {
        if (FlxG.keys.justPressed.F9)
        {
            dbgOn = !dbgOn;
            if (dbgText == null)
            {
                dbgText = new FlxText(offsetX + 5, offsetY + 5, 500, "");
                dbgText.setFormat(null, 16, 0xFFFFFF00, "left", FlxTextBorderStyle.OUTLINE, 0xFF000000);
                put(dbgText);
            }
            dbgText.visible = dbgOn;
            for (bx in dbgBoxes) bx.visible = dbgOn;
        }
        if (!dbgOn) return;

        dbgText.text = "x=" + Std.int(px) + "  y=" + Std.int(py) + "  tap=" + tap + "  held=" + tapHeld;

        while (dbgBoxes.length < dbgTargets.length)
        {
            final nb:FlxSprite = new FlxSprite(0, 0).makeGraphic(1, 1, 0x66FF0000);
            put(nb);
            dbgBoxes.push(nb);
        }

        for (i in 0...dbgTargets.length)
        {
            final s:FlxSprite = dbgTargets[i];
            final bx:FlxSprite = dbgBoxes[i];
            if (s == null)
            {
                bx.visible = false;
                continue;
            }
            bx.visible = true;
            bx.setGraphicSize(Std.int(Math.max(1, s.width)), Std.int(Math.max(1, s.height)));
            bx.updateHitbox();
            bx.setPosition(s.x, s.y);
        }
    }
    // ======================================================================
    //  MaigoSpeaker (clase del codigo fuente original, reconstruida aqui)
    //  Dialogo = [texto, emocion, sonido, seg por letra, pausa, tamano de fuente]
    // ======================================================================
    var spBacking:FlxSprite = null;
    var spIcon:FlxSprite = null;
    var spText:FlxText = null;
    var spEmoteOut:FlxSprite = null;
    var spSpeaking:Bool = false;
    var spLines:Array<Dynamic> = [];
    var spLine:Int = -1;
    var spFull:String = "";
    var spChars:Float = 0.0;
    var spDelay:Float = 0.05;
    var spHold:Float = 1.0;
    var spHoldT:Float = 0.0;
    var spTyping:Bool = false;
    var spVoice:Dynamic = null;
    var spOnEnd:Dynamic = null;
    var spOnStart:Dynamic = null;
    var spBaseSize:Int = 44;

    function makeSpeaker():Void
    {
        spBacking = new FlxSprite(offsetX, offsetY + 565).makeGraphic(Std.int(DW), 155, 0xFF000000);
        spBacking.alpha = 0.001;
        put(spBacking);

        spIcon = new FlxSprite(offsetX + 70, offsetY + 575);
        spIcon.frames = Paths.getSparrowAtlas("menus/gallery/maigo/talk");
        for (a in ["talk", "hype", "sad", "shy", "book", "hand", "eyesClosed", "embarrassed"]) spIcon.animation.addByPrefix(a, a, 15, true);
        spIcon.scale.set(3, 3);
        spIcon.visible = false;
        put(spIcon);

        spText = mkText(258, 590, 580, "", spBaseSize, 0xFFFFFFFF, "left", "sonic2HUD.ttf");
        put(spText);

        spEmoteOut = spIcon;
    }

    // true = Maigo habla con su retrato; false = habla otro sprite (emotes / intro)
    function swapSpeaker(useIcon:Bool):Void
    {
        spIcon.visible = useIcon && spSpeaking;
        if (useIcon)
        {
            spText.x = offsetX + 258;
            spText.fieldWidth = 580;
        }
        else
        {
            spText.x = offsetX;
            spText.fieldWidth = DW;
        }
    }

    function startDialogue(lines:Array<Dynamic>):Void
    {
        spLines = lines;
        spLine = -1;
        spSpeaking = true;
        spBacking.alpha = 0.5;
        if (spEmoteOut == spIcon) spIcon.visible = true;
        nextDialogueLine();
    }

    function nextDialogueLine():Void
    {
        spLine++;
        if (spLine >= spLines.length)
        {
            endDialogue();
            return;
        }

        final d:Array<Dynamic> = spLines[spLine];
        spFull = d[0];
        spText.text = "";
        spText.size = (d.length > 5 && d[5] != null) ? Std.int(d[5]) : spBaseSize;
        spDelay = d[3] != null ? d[3] : 0.05;
        spHold = d.length > 4 && d[4] != null ? d[4] : 1.0;
        spChars = 0.0;
        spHoldT = 0.0;
        spTyping = true;

        if (spEmoteOut != null && d[1] != null)
        {
            spEmoteOut.alpha = 1;
            spEmoteOut.animation.play(d[1], true);
        }

        spVoice = null;
        try { spVoice = FlxG.sound.play(Paths.sound("maigo/" + d[2])); }
        catch (e:Exception) {}

        if (spOnStart != null) spOnStart(d);
    }

    function endDialogue():Void
    {
        spSpeaking = false;
        spTyping = false;
        spBacking.alpha = 0.001;
        spText.text = "";
        spIcon.visible = false;
        spVoice = null;

        final cb:Dynamic = spOnEnd;
        spOnEnd = null;
        spOnStart = null;
        if (cb != null) cb();
    }

    function updateSpeaker(elapsed:Float):Void
    {
        if (!spSpeaking) return;

        if (spTyping)
        {
            spChars += elapsed / spDelay;
            var n:Int = Std.int(spChars);
            if (n >= spFull.length)
            {
                n = spFull.length;
                spTyping = false;
                spHoldT = 0.0;
            }
            spText.text = spFull.substr(0, n);
        }
        else
        {
            spHoldT += elapsed;
            final voiceDone:Bool = (spVoice == null) || !spVoice.playing;
            if (voiceDone && spHoldT >= 0.3) nextDialogueLine();
            else if (spVoice == null && spHoldT >= spHold) nextDialogueLine();
        }
    }

    // ======================================================================
    //  GALERIA
    // ======================================================================
    var underlay:FlxSprite = null;
    var main:FlxSprite = null;

    var painting:FlxSprite = null;
    var paintingHitbox:FlxSprite = null;

    var art:FlxSprite = null;
    var artHitbox:FlxSprite = null;

    var musicSpr:FlxSprite = null;
    var musicHitbox:FlxSprite = null;

    var maigo:FlxSprite = null;
    var maigoHitbox:FlxSprite = null;
    var maigoIntroduction:Bool = false;
    var maigoIntroAnim:FlxSprite = null;
    var maigoEmotes:FlxSprite = null;
    var prevMaigoConversation:Int = -1;

    var back:FlxSprite = null;

    var allowInput:Bool = true;
    var allowMouse:Bool = true;
    var galleryPhase:Int = 0;
    var debug:Bool = false;

    // pon en true cuando existan RewriteComputerState / RewriteMusicPlayerState y funcionen
    var ENABLE_COMPUTER:Bool = false;
    var ENABLE_MUSIC_PLAYER:Bool = false;

    var maigoDialogues:Array<Dynamic> = [];
    var lastMX:Float = 0.0;
    var lastMY:Float = 0.0;
    var kbSel:Int = -1; // seleccion con teclado/control: 0 cuadro, 1 monitor, 2 discman, 3 Maigo

    override function create():Void
    {
        super.create();
        initLayout();

        FlxG.mouse.useSystemCursor = false;
        FlxG.mouse.visible = false;

        if (sget("dataSelect", false) != true)
        {
            FlxG.camera.alpha = 0;
            new FlxTimer().start(0.001, function(t0:FlxTimer) {
                FlxG.camera.alpha = 1;
                FlxG.camera.flash(0xFF000000, 0.6);
            });
        }

        underlay = new FlxSprite(0, 0).makeGraphic(FlxG.width, FlxG.height, 0xFF393C10);
        put(underlay);

        final seen:Dynamic = pget("seenMaigoDialogues", null);
        maigoDialogues = (seen == null) ? [] : seen;

        main = new FlxSprite(0, 0);
        main.frames = Paths.getSparrowAtlas("menus/gallery/room");
        main.animation.addByPrefix("main", "room", 15, true);
        main.animation.addByPrefix("monitorZoom", "monitorZoom", 15, false);
        main.animation.addByPrefix("discmanZoom", "discmanZoom", 15, false);
        main.animation.addByPrefix("paintingZoom", "paintingZoom", 15, false);
        main.animation.play("main", true);
        main.scale.set(3.5, 3.5);
        ctr(main, 0x11);
        put(main);

        painting = new FlxSprite(offsetX + 607.5, offsetY + 261.5).loadGraphic(Paths.image("menus/gallery/painting"));
        painting.scale.set(3.5, 3.5);
        put(painting);

        paintingHitbox = new FlxSprite(offsetX + 550, offsetY + 225).makeGraphic(160, 115, 0xFFFFFFFF);
        paintingHitbox.alpha = 0.001;
        paintingHitbox.angle = -5;
        put(paintingHitbox);

        art = new FlxSprite(offsetX + 448.5, offsetY + 387.9);
        art.frames = Paths.getSparrowAtlas("menus/gallery/monitor");
        art.animation.addByPrefix("main", "monitor", 15, false);
        art.animation.addByPrefix("static", "staticMonitor", 15, true);
        art.animation.play("main");
        art.scale.set(3.5, 3.5);
        put(art);

        artHitbox = new FlxSprite(offsetX + 418, offsetY + 353).makeGraphic(88, 98, 0xFFFFFFFF);
        artHitbox.alpha = 0;
        put(artHitbox);

        musicSpr = new FlxSprite(offsetX + 561.5, offsetY + 435.9).loadGraphic(Paths.image("menus/gallery/discman"));
        musicSpr.scale.set(3.5, 3.5);
        put(musicSpr);

        musicHitbox = new FlxSprite(offsetX + 527, offsetY + 419).makeGraphic(105, 45, 0xFFFFFFFF);
        musicHitbox.alpha = 0;
        put(musicHitbox);

        maigo = new FlxSprite(offsetX + 310, offsetY + 275);
        maigo.frames = Paths.getSparrowAtlas("menus/gallery/maigo/gallery");
        maigo.animation.addByPrefix("idleA", "idleA", 15, true);
        maigo.animation.addByPrefix("idleB", "idleB", 15, true);
        maigo.animation.addByPrefix("idleC", "idleC", 15, true);
        final maigoIdles:Array<String> = ["idleA", "idleB", "idleC"];
        maigo.animation.play(maigoIdles[FlxG.random.int(0, maigoIdles.length - 1)]);
        maigo.scale.set(3, 3);
        put(maigo);

        maigoHitbox = new FlxSprite(offsetX + 10, offsetY + 275).makeGraphic(10, 10, 0xFFFFFFFF);
        maigoHitbox.alpha = 0;
        put(maigoHitbox);

        switch (maigo.animation.curAnim.name)
        {
            case "idleA":
                maigoHitbox.setPosition(offsetX + 126, offsetY + 125);
                maigoHitbox.scale.set(17, 50);

            case "idleB":
                maigoHitbox.setPosition(offsetX + 145, offsetY + 120);
                maigoHitbox.scale.set(15, 51);

            case "idleC":
                maigoHitbox.setPosition(offsetX + 106, offsetY + 125);
                maigoHitbox.scale.set(21, 50);
        }

        maigoHitbox.updateHitbox();

        sset("dataSelect", false);

        maigoEmotes = new FlxSprite();
        maigoEmotes.frames = Paths.getSparrowAtlas("menus/gallery/maigo/galleryEmotes");
        maigoEmotes.animation.addByPrefix("talk", "talk", 15, true);
        maigoEmotes.animation.addByPrefix("hype", "hype", 15, true);
        maigoEmotes.animation.addByPrefix("sad", "sad", 15, true);
        maigoEmotes.animation.addByPrefix("shy", "shy", 15, true);
        maigoEmotes.animation.addByPrefix("book", "book", 15, false);
        maigoEmotes.animation.addByPrefix("hand", "hand", 15, true);
        maigoEmotes.scale.set(3.3, 3.3);
        ctr(maigoEmotes, 0x11);
        maigoEmotes.x -= 30;
        maigoEmotes.alpha = 0.001;
        put(maigoEmotes);

        maigoIntroAnim = new FlxSprite();
        maigoIntroAnim.frames = Paths.getSparrowAtlas("menus/gallery/maigo/intro");
        maigoIntroAnim.animation.addByPrefix("anim", "anim", 15, false);
        maigoIntroAnim.scale.set(3.3, 3.3);
        ctr(maigoIntroAnim, 0x11);
        maigoIntroAnim.alpha = 0.001;
        put(maigoIntroAnim);

        back = new FlxSprite(offsetX + 10, offsetY + 635).loadGraphic(Paths.image("menus/options/back"));
        back.scale.set(3, 3);
        back.updateHitbox();
        back.alpha = 0.001;
        put(back);

        try { makeSpeaker(); }
        catch (e:Exception) { trace("[RewriteGallery] Error creando el speaker: " + e); }

        addBars();
        makeCursor();

        if (pget("seenMaigoIntroduction", false) != true || debug)
        {
            allowInput = false;
            cursorAnim("default");
            maigo.alpha = 0.001;
            maigoIntroduction = true;

            new FlxTimer().start(0.5, function(t1:FlxTimer) {
                startMaigoIntroduction();
            });
        }
        else
        {
            back.alpha = 1;
            playGalleryMusic();
        }
    }

    function playGalleryMusic():Void
    {
        if (FlxG.sound.music == null || !FlxG.sound.music.playing) playMenuMusic("meet-maigo", 1.0, true);
        if (FlxG.sound.music != null)
        {
            if (FlxG.sound.music.paused) FlxG.sound.music.resume();
            FlxG.sound.music.volume = 1;
        }
    }

    // texto de la intro: aparece completo, ocupa todo el ancho
    function introSay(str:String):Void
    {
        spText.text = str;
        spText.size = spBaseSize;
    }

    function startMaigoIntroduction():Void
    {
        allowInput = false;
        cursorAnim("default");

        maigo.alpha = 0.001;
        maigoIntroduction = true;
        maigoIntroAnim.alpha = 1;
        maigoIntroAnim.animation.play("anim", true);
        FlxG.sound.play(Paths.sound("maigo/intro"));
        startMaigoDialogue();

        new FlxTimer().start(13, function(t2:FlxTimer) {
            allowInput = true;
            maigo.alpha = 1;
            maigoIntroduction = false;
            maigoIntroAnim.alpha = 0.001;
            spText.text = "";
            spBacking.alpha = 0.001;
            spSpeaking = false;
            swapSpeaker(true);
            playGalleryMusic();
            back.alpha = 1;
            pset("seenMaigoIntroduction", true);
        });
    }

    function startMaigoDialogue():Void
    {
        new FlxTimer().start(0.85, function(t3:FlxTimer) {
            swapSpeaker(false);
            spBacking.alpha = 0.5;
            introSay("Salutations, my friend!");
        });

        new FlxTimer().start(2.67, function(t4:FlxTimer) {
            introSay("Welcome to my place of abode!");
        });

        new FlxTimer().start(4.94, function(t5:FlxTimer) {
            introSay("I didn't have time to set the cubes and triangles in their designated places,");
        });

        new FlxTimer().start(8.93, function(t6:FlxTimer) {
            introSay("Excuse me for that there, all over the place,");
        });

        new FlxTimer().start(10.75, function(t7:FlxTimer) {
            introSay("But please! Make yourself at home.");
        });
    }

    function hideMain():Void
    {
        for (i in [painting, musicSpr, art, maigo, back]) i.alpha = 0.001;
    }

    // si la pantalla de destino todavia no existe, se vuelve a la sala
    function openOrRestore(name:String):Void
    {
        saveSeenDialogues();
        if (go(name)) return;

        underlay.color = 0xFF393C10;
        main.animation.play("main", true);
        for (i in [painting, musicSpr, art, maigo, back]) i.alpha = 1;
        allowInput = true;
    }

    function startMaigoConversation():Void
    {
        maigo.alpha = 0.001;
        back.alpha = 0.001;
        final maigoConversation:Int = FlxG.random.int(0, 4, [prevMaigoConversation]);
        prevMaigoConversation = maigoConversation;
        spEmoteOut = maigoEmotes;
        swapSpeaker(false);
        spOnEnd = function() {
            back.alpha = 1;
            maigoEmotes.alpha = 0.001;
            maigo.alpha = 1;
            spEmoteOut = spIcon;
            swapSpeaker(true);
            fadeMusicTo(1, 0.2);
        };

        new FlxTimer().start(0.1, function(t8:FlxTimer) {
            maigoEmotes.alpha = 1;
            fadeMusicTo(0.3, 0.2);
            switch (maigoConversation)
            {
                case 0:
                    startDialogue([
                        ["Needing a hand, fella?", "talk", "needingAHand/0", 0.05, 1],
                        ["I can lend you mine if you want!", "hand", "needingAHand/1", 0.05, 1],
                        ["Just don't lose it, okay?", "shy", "needingAHand/2", 0.06, 1],
                        ["I can't spend another week trying to find it, like that time Mr. Sonic pranked me...", "sad", "needingAHand/3", 0.045, 0.8, 30]
                    ]);

                case 1:
                    startDialogue([
                        ["Feel free to look around!", "hype", "lookAround/0", 0.05, 0.7],
                        ["I just like standing here.", "talk", "lookAround/1", 0.05, 1]
                    ]);

                case 2:
                    startDialogue([
                        ["Did you know a triangle has the same amount of sides as a cube?", "talk", "geometry/0", 0.06, 1.5, 35],
                        ["Well, me neither...", "shy", "geometry/1", 0.05, 1],
                        ["Thank God I always carry my geometry book around!", "book", "geometry/2", 0.05, 0.7]
                    ]);

                case 3:
                    startDialogue([
                        ["Hello!", "talk", "hello/" + FlxG.random.int(0, 2), 0.05, 0.8]
                    ]);

                case 4:
                    startDialogue([
                        ["You're also friends with Mr. Sonic, aren't you?", "hype", "mrSonic", 0.045, 1]
                    ]);
            }
        });
    }

    function clickPainting():Void
    {
        allowInput = false;
        hideMain();
        main.animation.play("paintingZoom", true);
        main.animation.finishCallback = function(wow:String) {
            galleryPhase = 1;
            main.animation.finishCallback = null;
            allowInput = true;
            cursorAnim("default");

            var seenDialogue:Bool = false;
            for (i in maigoDialogues)
            {
                if (i == "maigoArtwork")
                {
                    seenDialogue = true;
                    break;
                }
            }

            if (!seenDialogue)
            {
                new FlxTimer().start(0.7, function(t9:FlxTimer) {
                    fadeMusicTo(0.3, 0.2);
                    spOnEnd = function() {
                        back.alpha = 1;
                        fadeMusicTo(1, 0.2);
                        maigoDialogues.push("maigoArtwork");
                    };
                    startDialogue([
                        ["Ah... what a delightful piece of art!", "eyesClosed", "artwork/0", 0.05, 1.6, 39],
                        ["I don't recall where I got this from, but it almost feels like something sacred...", "talk", "artwork/1", 0.05, 1.6, 29]
                    ]);
                });
            }
            else
            {
                back.alpha = 1;
            }
        };
    }


    function hotspot(i:Int):FlxSprite
    {
        switch (i)
        {
            case 0: return paintingHitbox;
            case 1: return artHitbox;
            case 2: return musicHitbox;
            default: return maigoHitbox;
        }
    }

    function kbMove(dir:Int):Void
    {
        kbSel += dir;
        if (kbSel > 3) kbSel = 0;
        if (kbSel < 0) kbSel = 3;
        FlxG.sound.play(Paths.sound("scrollMenu"), 0.8);
    }

    override function update(elapsed:Float):Void
    {
        super.update(elapsed);
        readPointer();
        dbgSet([paintingHitbox, artHitbox, musicHitbox, maigoHitbox, back]);
        dbgUpdate();
        updateSpeaker(elapsed);

        // ---- teclado / control: izquierda-derecha elige, aceptar activa ----
        if (allowInput && !spSpeaking && galleryPhase == 0)
        {
            if (ctl().UI_RIGHT_P) kbMove(1);
            if (ctl().UI_LEFT_P) kbMove(-1);
        }
        if (FlxG.mouse.screenX != lastMX || FlxG.mouse.screenY != lastMY) kbSel = -1;
        lastMX = FlxG.mouse.screenX;
        lastMY = FlxG.mouse.screenY;

        if (kbSel >= 0 && allowInput && !spSpeaking && galleryPhase == 0)
        {
            final hs:FlxSprite = hotspot(kbSel);
            cursorForceX = hs.x + hs.width / 2;
            cursorForceY = hs.y + hs.height / 2;
            if (ctl().ACCEPT)
            {
                px = cursorForceX;
                py = cursorForceY;
                tap = true;
            }
        }
        else
        {
            cursorForceX = -1.0;
            cursorForceY = -1.0;
        }

        final hovering:Bool = (galleryPhase == 0 && (over(artHitbox) || over(musicHitbox) || over(paintingHitbox) || over(maigoHitbox)))
            || (over(back) && back.alpha == 1);

        if (!spSpeaking)
        {
            if (allowInput && hovering) cursorAnim("hover");
            else if (allowInput && !hovering) cursorAnim("default");
            else if (!allowInput && !maigoIntroduction) cursorAnim("wait");
        }
        else cursorAnim("default");

        if (allowInput && !spSpeaking)
        {
            if (galleryPhase == 0 && tap && allowMouse)
            {
                if (over(paintingHitbox))
                {
                    clickPainting();
                }
                else if (over(musicHitbox))
                {
                    if (!ENABLE_MUSIC_PLAYER)
                    {
                        FlxG.sound.play(Paths.sound("denied"));
                        return;
                    }
                    allowInput = false;
                    hideMain();
                    main.animation.play("discmanZoom", true);
                    main.animation.finishCallback = function(wow:String) {
                        main.animation.finishCallback = null;
                        openOrRestore("RewriteMusicPlayerState");
                    };
                }
                else if (over(artHitbox))
                {
                    if (!ENABLE_COMPUTER)
                    {
                        FlxG.sound.play(Paths.sound("denied"));
                        return;
                    }
                    allowInput = false;
                    hideMain();
                    underlay.color = 0xFF0F070F;
                    main.animation.play("monitorZoom", true);
                    main.animation.finishCallback = function(wow:String) {
                        main.animation.finishCallback = null;
                        openOrRestore("RewriteComputerState");
                    };
                }
                else if (over(maigoHitbox) && maigo.alpha == 1)
                {
                    startMaigoConversation();
                }
            }

            if (ctl().BACK || (tap && back.alpha == 1 && over(back))) leaveGallery();
        }
    }

    function leaveGallery():Void
    {
        switch (galleryPhase)
        {
            case 0:
                allowInput = false;
                allowMouse = false;
                galleryPhase = -1;
                for (i in [main, painting, musicSpr, art, customCursor, maigo, back]) FlxTween.color(i, 0.4, 0xFFFFFFFF, 0xFF0000FF);
                fadeMusicTo(0, 0.5);
                FlxG.camera.fade(0xFF000000, 0.7, false, null, true);
                new FlxTimer().start(0.75, function(t10:FlxTimer) {
                    stopMusic();
                    saveSeenDialogues();
                    go("RewriteMainMenuState");
                });

            case 1:
                allowInput = false;
                back.alpha = 0.001;
                main.animation.play("paintingZoom", true, true);
                main.animation.finishCallback = function(wow:String) {
                    back.alpha = 1;
                    galleryPhase = 0;
                    main.animation.play("main", true);
                    main.animation.finishCallback = null;
                    allowInput = true;
                    final maigoIdles:Array<String> = ["idleA", "idleB", "idleC"];
                    maigo.animation.play(maigoIdles[FlxG.random.int(0, maigoIdles.length - 1)]);
                    for (i in [painting, musicSpr, art, maigo]) i.alpha = 1;
                };
        }
    }

    function saveSeenDialogues():Void
    {
        pset("seenMaigoDialogues", maigoDialogues);
    }
}
