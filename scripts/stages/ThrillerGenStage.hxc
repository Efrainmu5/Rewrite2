        FlxTween.tween(itsSpr, {x: 550}, 0.5, {ease: FlxEase.quadOut});

      case 8: itsSpr?.animation.play("2", true);
      case 9: itsSpr?.animation.play("3", true);
      case 10: if (itsSpr != null) FlxTween.tween(itsSpr, {alpha: 0}, 0.5, {ease: FlxEase.linear, onComplete: function(t:FlxTween) { itsSpr.destroy(); }});

      case 11:
        beSpr = new FunkinSprite();
        beSpr.frames = Paths.getSparrowAtlas("tgeBG/tgeLyrics");
        beSpr.animation.addByPrefix("be", "1be", 1, false);
        beSpr.animation.play("be");
        beSpr.scale.set(2, 2);
        beSpr.updateHitbox();
