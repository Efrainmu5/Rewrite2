        okaySpr.scale.set(2, 2);
        okaySpr.updateHitbox();
        okaySpr.setPosition(dad.x + 350, 1100);
        okaySpr.antialiasing = false;
        spawnLyric(okaySpr, LYRIC_Z);
        ps.currentStage.refresh();
        FlxTween.tween(okaySpr, {y: 780}, 0.75, {ease: FlxEase.quadOut});

      case 18:
        for (s in [its2Spr, allSpr, okaySpr])
