        playSpr.updateHitbox();
        playSpr.setPosition(lx + 100, 0);
        playSpr.scrollFactor.set(0, 0);
        playSpr.antialiasing = false;
        hudAdd(playSpr, ps.camCutscene, 3200);
        FlxTween.tween(playSpr, {y: 95}, 0.5, {ease: FlxEase.quadOut});

      case 20:
        final px:Float = playSpr != null ? playSpr.x : 490;
        aSpr = new FunkinSprite();
        aSpr.frames = Paths.getSparrowAtlas("tgeBG/tgeLyrics");
        aSpr.animation.addByPrefix("a", "3a0", 1, false);
        aSpr.animation.play("a");
        aSpr.scale.set(2, 2);
        aSpr.updateHitbox();
        aSpr.setPosition(px + 120, 0);
        aSpr.scrollFactor.set(0, 0);
        aSpr.antialiasing = false;
        hudAdd(aSpr, ps.camCutscene, 3200);
        FlxTween.tween(aSpr, {y: 100}, 0.5, {ease: FlxEase.quadOut});

      case 21:
        final ax2:Float = aSpr != null ? aSpr.x : 610;
        gameSpr = new FunkinSprite();
        gameSpr.frames = Paths.getSparrowAtlas("tgeBG/tgeLyrics");
        gameSpr.animation.addByPrefix("1game", "4game", 1, false);
        gameSpr.animation.play("1game");
        gameSpr.scale.set(2, 2);
        gameSpr.updateHitbox();
        gameSpr.setPosition(ax2 + 80, 0);
        gameSpr.scrollFactor.set(0, 0);
        gameSpr.antialiasing = false;
        hudAdd(gameSpr, ps.camCutscene, 3200);
        FlxTween.tween(gameSpr, {y: 80}, 0.5, {ease: FlxEase.quadOut});

      case 22:
        fForSpr = new FunkinSprite();
        fForSpr.frames = Paths.getSparrowAtlas("tgeBG/tgeLyrics");
        fForSpr.animation.addByPrefix("1for", "1for", 1, false);
        fForSpr.animation.play("1for");
        fForSpr.scale.set(2, 2);
        fForSpr.updateHitbox();
        fForSpr.setPosition(325, 720);
        fForSpr.scrollFactor.set(0, 0);
        fForSpr.antialiasing = false;
        hudAdd(fForSpr, ps.camCutscene, 3200);
        FlxTween.tween(fForSpr, {y: 500}, 0.5, {ease: FlxEase.quadOut});

      case 23:
        final fx:Float = fForSpr != null ? fForSpr.x : 325;
        oldSpr = new FunkinSprite();
        oldSpr.frames = Paths.getSparrowAtlas("tgeBG/tgeLyrics");
        oldSpr.animation.addByPrefix("old", "2old", 1, false);
        oldSpr.animation.play("old");
        oldSpr.scale.set(2, 2);
        oldSpr.updateHitbox();
        oldSpr.setPosition(fx + 120, 720);
        oldSpr.scrollFactor.set(0, 0);
        oldSpr.antialiasing = false;
        hudAdd(oldSpr, ps.camCutscene, 3200);
        FlxTween.tween(oldSpr, {y: 520}, 0.5, {ease: FlxEase.quadOut});

      case 24:
        final ox:Float = oldSpr != null ? oldSpr.x : 445;
        timesSpr = new FunkinSprite();
        timesSpr.frames = Paths.getSparrowAtlas("tgeBG/tgeLyrics");
        timesSpr.animation.addByPrefix("times", "3times", 1, false);
        timesSpr.animation.play("times");
        timesSpr.scale.set(2, 2);
        timesSpr.updateHitbox();
        timesSpr.setPosition(ox + 130, 720);
        timesSpr.scrollFactor.set(0, 0);
        timesSpr.antialiasing = false;
        hudAdd(timesSpr, ps.camCutscene, 3200);
        FlxTween.tween(timesSpr, {y: 490}, 0.5, {ease: FlxEase.quadOut});

      case 25:
        final tx:Float = timesSpr != null ? timesSpr.x : 575;
        sakeSpr = new FunkinSprite();
        sakeSpr.frames = Paths.getSparrowAtlas("tgeBG/tgeLyrics");
        sakeSpr.animation.addByPrefix("sake", "4sake", 1, false);
        sakeSpr.animation.play("sake");
        sakeSpr.scale.set(2, 2);
        sakeSpr.updateHitbox();
        sakeSpr.setPosition(tx + 150, 720);
        sakeSpr.scrollFactor.set(0, 0);
        sakeSpr.antialiasing = false;
        hudAdd(sakeSpr, ps.camCutscene, 3200);
        FlxTween.tween(sakeSpr, {y: 510}, 0.5, {ease: FlxEase.quadOut});

      case 26:
        for (s in [letsSpr, playSpr, aSpr, gameSpr, fForSpr, oldSpr, timesSpr, sakeSpr])
        {
          if (s != null) s.destroy();
        }
        ps.camHUD.alpha = 1;

      case 27:
        youareSpr = new FunkinSprite();
        youareSpr.frames = Paths.getSparrowAtlas("tgeBG/tgeLyrics");
        youareSpr.animation.addByPrefix("you", "1you2", 1, false);
        youareSpr.animation.addByPrefix("are", "2are2", 1, false);
        youareSpr.animation.addByPrefix("flawed", "3flawed", 1, false);
        youareSpr.animation.play("you", true);
        youareSpr.scale.set(2, 2);
        youareSpr.updateHitbox();
        youareSpr.setPosition(140, 720);
        youareSpr.antialiasing = false;
        spawnLyric(youareSpr, LYRIC_Z);

      case 28: youareSpr?.animation.play("are", true);
      case 29: youareSpr?.animation.play("flawed", true);
      case 30:
        youareSpr?.destroy();
        iamgSpr = new FunkinSprite();
        iamgSpr.frames = Paths.getSparrowAtlas("tgeBG/tgeLyrics");
        iamgSpr.animation.addByPrefix("i", "1i0", 1, false);
        iamgSpr.animation.addByPrefix("am", "2am0", 1, false);
        iamgSpr.animation.addByPrefix("god", "3god0", 1, false);
        iamgSpr.animation.play("i", true);
        iamgSpr.scale.set(2, 2);
        iamgSpr.updateHitbox();
        iamgSpr.setPosition(640, 720);
        iamgSpr.antialiasing = false;
        spawnLyric(iamgSpr, LYRIC_Z);

      case 31: iamgSpr?.animation.play("am", true);
      case 32: iamgSpr?.animation.play("god", true);
      case 33: iamgSpr?.destroy();

      case 34:
        FlxTween.tween(blueSpr, {alpha: 0}, 0.3, {ease: FlxEase.quadIn});
        iamsSpr = new FunkinSprite();
        iamsSpr.frames = Paths.getSparrowAtlas("tgeBG/tgeLyrics");
        iamsSpr.animation.addByPrefix("i", "1i20", 1, false);
        iamsSpr.animation.addByPrefix("am", "2am20", 1, false);
        iamsSpr.animation.addByPrefix("sonic", "3sonic0", 1, false);
        iamsSpr.animation.addByPrefix("sawnick", "4sonicFucked0", 1, false);
        iamsSpr.animation.play("i", true);
        iamsSpr.scale.set(3, 3);
        iamsSpr.updateHitbox();
        iamsSpr.setPosition(315, 100);
        iamsSpr.antialiasing = false;
        iamsSpr.scrollFactor.set(0, 0);
        hudAdd(iamsSpr, ps.camCutscene, 3250);

      case 35: iamsSpr?.animation.play("am", true);
      case 36: iamsSpr?.animation.play("sonic", true);
      case 37: iamsSpr?.animation.play("sawnick", true);
      case 38: iamsSpr?.destroy();
      default:
    }
  }

  function triggerCountdownStep(c:Int):Void
  {
    if (countdownTGE == null) return;
    switch (c)
    {
      case 3: countdownTGE.animation.play("three", true);
      case 2: countdownTGE.animation.play("two", true);
      case 1: countdownTGE.animation.play("one", true);
      case 0: countdownTGE.animation.play("go", true);
      case -1: countdownTGE.alpha = 0.001;
      default:
    }
  }

  var lastSecFade:Int = -1;

  function updateBfFade():Void
  {
    final bf:BaseCharacter = getBoyfriend();
    if (bf == null || stepI < 0 || stepI >= 646) return;

    final sec:Int = Std.int(stepI / 16);
    if (sec == lastSecFade) return;
    lastSecFade = sec;

    bf.visible = true;
    tweenAlpha(bf, 1, 0.5, "quadInOut");
  }

  override function onPause() {
        super.onPause();
        FlxTween.globalManager.forEach((tween:FlxTween) -> tween.active = false);
        FlxTimer.globalManager.forEach((timer:FlxTimer) -> timer.active = false);
    }

    override function onResume() {
        super.onResume();
        FlxTween.globalManager.forEach((tween:FlxTween) -> tween.active = true);
        FlxTimer.globalManager.forEach((timer:FlxTimer) -> timer.active = true);
    }
}