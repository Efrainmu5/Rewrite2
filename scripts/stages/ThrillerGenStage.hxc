        letsSpr.animation.play("lets");
        letsSpr.scale.set(2, 2);
        letsSpr.updateHitbox();
        letsSpr.setPosition(390, 0);
        letsSpr.scrollFactor.set(0, 0);
        letsSpr.antialiasing = false;
        hudAdd(letsSpr, ps.camCutscene, 3200);
        FlxTween.tween(letsSpr, {y: 100}, 0.5, {ease: FlxEase.quadOut});

      case 19:
