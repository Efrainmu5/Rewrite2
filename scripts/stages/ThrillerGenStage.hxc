        FlxTween.tween(allSpr, {x: dad.x + 300}, 0.75, {ease: FlxEase.quadOut});

      case 17:
        okaySpr = new FunkinSprite();
        okaySpr.frames = Paths.getSparrowAtlas("tgeBG/tgeLyrics");
        okaySpr.animation.addByPrefix("okay", "3okay", 1, false);
