        itsSpr.animation.addByPrefix("1", "1itsawaste", 1, false);
        itsSpr.animation.addByPrefix("2", "2itsawaste", 1, false);
        itsSpr.animation.addByPrefix("3", "3itsawaste", 1, false);
        itsSpr.animation.play("1", true);
        itsSpr.scale.set(2, 2);
        itsSpr.updateHitbox();
        itsSpr.setPosition(210, 700);
        itsSpr.antialiasing = false;
        itsSpr.scrollFactor.set(1, 1);
        spawnLyric(itsSpr, LYRIC_Z);
